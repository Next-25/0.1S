<Window
  x:Class="_01S.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:views="clr-namespace:_01S.Views"
  xmlns:vm="clr-namespace:_01S.ViewModels"
  Title="0.1S"
  Width="800"
  Height="450"
  d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
  ThemeMode="System"
  WindowState="Maximized"
  mc:Ignorable="d"
>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Навигационная панель  -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10" Orientation="Horizontal">
      <Button
        Width="100"
        Margin="0,0,5,0"
        Command="{Binding NavigateHomeCommand}"
        Content="Главная"
      />
      <Button
        Width="100"
        Margin="0,0,5,0"
        Command="{Binding NavigateProductsCommand}"
        Content="Товары"
      />
      <Button Width="100" Command="{Binding NavigateDocumentsCommand}" Content="Документы" />
    </StackPanel>

    <!--  Область навигации (Host)  -->
    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
      <ContentControl Content="{Binding Navigation.CurrentView}" />
    </Border>
  </Grid>
</Window>
