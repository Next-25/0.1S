<UserControl
    x:Class="_01S.Views.DocumentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:_01S.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:DocumentsViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding NavigateCreateDocumentCommand}"
                Content="Новый" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding NavigateEditDocumentCommand}"
                Content="Редактировать" />
            <Button Command="{Binding DeleteDocumentCommand}" Content="Удалить" />
        </StackPanel>

        <!--  Привязка коллекции к DataGrid  -->
        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding Documents}"
            SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="160"
                    Binding="{Binding Number}"
                    Header="Номер" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="160"
                    Binding="{Binding Date}"
                    Header="Дата" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Customer}"
                    Header="Контрагент" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding SumOfDocument}"
                    Header="Сумма документа" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
