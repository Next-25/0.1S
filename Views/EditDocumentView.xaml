<UserControl
  x:Class="_01S.Views.EditDocumentView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:_01S.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewmodels="clr-namespace:_01S.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewmodels:EditDocumentViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  1. Панель кнопок сохранения/отмены  -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16" Orientation="Horizontal">
      <TextBlock
        Margin="0,0,16,0"
        VerticalAlignment="Center"
        FontSize="20"
        FontWeight="Bold"
        Text="{Binding Title}"
      />
      <Button
        Margin="0,0,8,0"
        Padding="12,6"
        Command="{Binding SaveDocumentCommand}"
        Content="Сохранить"
      />
      <Button Padding="12,6" Command="{Binding CancelDocumentCommand}" Content="Отмена" />
    </StackPanel>

    <!--  2. Шапка документа  -->
    <UniformGrid Grid.Row="1" Margin="0,0,0,16" Columns="3">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Margin="0,0,0,4" Text="Номер документа" />
        <TextBox Text="{Binding EditableDocument.Number, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="4,0,4,0">
        <TextBlock Margin="0,0,0,4" Text="Дата" />
        <TextBox Text="{Binding EditableDocument.Date, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="8,0,0,0">
        <TextBlock Margin="0,0,0,4" Text="Клиент" />
        <TextBox Text="{Binding EditableDocument.Customer, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </UniformGrid>

    <!--  3. Панель добавления товара в табличную часть  -->
    <GroupBox Grid.Row="2" Margin="0,0,0,16" Padding="8" Header="Добавление товара">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Выбор товара из БД  -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Margin="0,0,0,4" Text="Товар" />
          <ComboBox
            DisplayMemberPath="Name"
            ItemsSource="{Binding AvailableProducts}"
            SelectedItem="{Binding SelectedProduct}"
          />
        </StackPanel>

        <!--  Ввод количества  -->
        <StackPanel Grid.Column="1" Margin="0,0,8,0">
          <TextBlock Margin="0,0,0,4" Text="Количество" />
          <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  Кнопка Добавить  -->
        <Button
          Grid.Column="2"
          Height="26"
          Margin="0,0,8,0"
          Padding="12,0"
          VerticalAlignment="Bottom"
          Command="{Binding AddLineCommand}"
          Content="Добавить"
        />

        <!--  Кнопка Удалить выделенную строку  -->
        <Button
          Grid.Column="3"
          Height="26"
          Padding="12,0"
          VerticalAlignment="Bottom"
          Command="{Binding RemoveLineCommand}"
          Content="Удалить строку"
        />
      </Grid>
    </GroupBox>

    <!--  4. Табличная часть документа  -->
    <DataGrid
      Grid.Row="3"
      AutoGenerateColumns="False"
      GridLinesVisibility="Horizontal"
      IsReadOnly="True"
      ItemsSource="{Binding EditableDocument.Lines}"
      SelectedItem="{Binding SelectedLine}"
    >
      <DataGrid.Columns>
        <!--  Название товара берут через навигационное свойство Product.Name  -->
        <DataGridTextColumn Width="*" Binding="{Binding Product.Name}" Header="Товар" />
        <DataGridTextColumn Width="120" Binding="{Binding Quantity}" Header="Количество" />
        <DataGridTextColumn
          Width="120"
          Binding="{Binding Price, StringFormat={}{0:C}}"
          Header="Цена"
        />
        <DataGridTextColumn
          Width="120"
          Binding="{Binding Sum, StringFormat={}{0:C}, UpdateSourceTrigger=PropertyChanged}"
          Header="Сумма"
        />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
      <TextBlock Margin="0,0,16,0" Text="Сумма документа" />
      <TextBlock
        Margin="0,0,16,0"
        Text="{Binding EditableDocument.SumOfDocument, StringFormat={}{0:C}}"
      />
    </StackPanel>
  </Grid>
</UserControl>
