<UserControl
    x:Class="_01S.Views.DocumentDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:_01S.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:DocumentDetailsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  1. Панель кнопок сохранения/отмены  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,16"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <Button
                Margin="0,0,8,0"
                Padding="12,6"
                Command="{Binding SaveCommand}"
                Content="Сохранить"
                IsDefault="True" />
            <Button
                Padding="12,6"
                Command="{Binding CancelCommand}"
                Content="Отмена"
                IsCancel="True" />
        </StackPanel>

        <!--  2. Шапка документа  -->
        <UniformGrid
            Grid.Row="1"
            Margin="0,0,0,16"
            Columns="3">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Margin="0,0,0,4" Text="Номер документа" />
                <TextBox Text="{Binding EditableDocument.Number, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="4,0,4,0">
                <TextBlock Margin="0,0,0,4" Text="Дата" />
                <DatePicker SelectedDate="{Binding EditableDocument.Date, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
                <TextBlock Margin="0,0,0,4" Text="Контрагент" />
                <TextBox Text="{Binding EditableDocument.Customer, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </UniformGrid>

        <!--  3. Панель добавления товара в табличную часть  -->
        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,16"
            Padding="8"
            Header="Добавление товара">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Выбор товара из БД  -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4" Text="Товар" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding AvailableProducts}"
                        SelectedItem="{Binding SelectedProduct}">
                        <!--  Стилизация самих элементов выпадающего списка  -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <!--  Растягиваем элемент на всю ширину и высоту строки списка  -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <!--  Убираем внешние отступы между строками списка  -->
                                <Setter Property="Margin" Value="0" />
                                <!--  Переносим отступы внутрь элемента, чтобы область клика была максимальной  -->
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                </StackPanel>

                <!--  Ввод количества  -->
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Margin="0,0,0,4" Text="Количество" />
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Кнопка Добавить  -->
                <Button
                    Grid.Column="2"
                    Height="26"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    VerticalAlignment="Bottom"
                    Command="{Binding AddLineCommand}"
                    Content="Добавить" />

                <!--  Кнопка Удалить выделенную строку  -->
                <Button
                    Grid.Column="3"
                    Height="26"
                    Padding="12,0"
                    VerticalAlignment="Bottom"
                    Command="{Binding RemoveLineCommand}"
                    Content="Удалить строку" />
            </Grid>
        </GroupBox>

        <!--  4. Табличная часть документа  -->
        <DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding EditableDocument.Lines}"
            SelectedItem="{Binding SelectedLine}">
            <DataGrid.Columns>
                <!--  Название товара только для чтения  -->
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Product.Name}"
                    Header="Товар" />

                <!--  Количество можно редактировать прямо в ячейке  -->
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                    Header="Количество" />

                <!--  Цена товара зафиксирована при добавлении  -->
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Price, StringFormat={}{0:C}}"
                    Header="Цена" />

                <!--  Сумма рассчитывается автоматически  -->
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Sum, StringFormat={}{0:C}}"
                    Header="Сумма" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  5. Итоговая сумма  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,16,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="Сумма документа:" />
            <TextBlock
                FontSize="14"
                FontWeight="Bold"
                Text="{Binding EditableDocument.SumOfDocument, StringFormat={}{0:C}}" />
        </StackPanel>
    </Grid>
</UserControl>
