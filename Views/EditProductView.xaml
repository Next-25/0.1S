<UserControl
  x:Class="_01S.Views.EditProductView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:_01S.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:viewmodels="clr-namespace:_01S.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewmodels:EditProductViewModel}"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d"
>
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBlock Margin="0,0,8,16" FontSize="20" FontWeight="Bold" Text="{Binding Title}" />
      <Button
        Margin="0,0,8,0"
        Command="{Binding SaveChangeProductCommand}"
        Content="Сохранить"
        IsDefault="True"
      />
      <Button
        Margin="0,0,8,0"
        Command="{Binding CancelProductCommand}"
        Content="Отмена"
        IsCancel="True"
      />
    </StackPanel>

    <!--  Привязка коллекции к DataGrid  -->
    <StackPanel Grid.Row="1" Margin="16">
      <TextBlock Margin="0,0,0,16" Text="Название товара" />
      <TextBox
        Margin="0,0,0,16"
        Text="{Binding EditableProduct.Name, UpdateSourceTrigger=PropertyChanged}"
      />
      <TextBlock Margin="0,0,0,16" Text="Цена" />
      <TextBox Text="{Binding EditableProduct.Price, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
  </Grid>
</UserControl>
