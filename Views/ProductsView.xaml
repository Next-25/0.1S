<UserControl
    x:Class="_01S.Views.ProductsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:_01S.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ProductsViewModel}"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="{Binding Title}" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding NavigateCreateProductCommand}"
                Content="Новый" />
            <Button
                Margin="0,0,8,0"
                Command="{Binding NavigateEditProductCommand}"
                Content="Редактировать" />
            <Button Command="{Binding DeleteProductCommand}" Content="Удалить" />
        </StackPanel>

        <!--  Привязка коллекции к DataGrid  -->
        <DataGrid
            x:Name="ProdutsList"
            Grid.Row="1"
            AutoGenerateColumns="False"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding Products}"
            SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="60"
                    Binding="{Binding Product.Id}"
                    Header="ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Product.Name}"
                    Header="Наименование" />
                <DataGridTextColumn
                    Width="Auto"
                    MinWidth="120"
                    Binding="{Binding Product.Price, StringFormat='{}{0:C}'}"
                    Header="Цена" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding StockQuantity, StringFormat=0.##}"
                    Header="Остаток"
                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
